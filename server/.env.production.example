PORT=4000
NODE_ENV=production
JWT_SECRET=generate-a-long-random-secret-min-32-chars

# Vercel frontend URL(s) — comma-separated for production + preview
# Example: https://tj-fms.vercel.app,https://tj-fms-git-main-yourteam.vercel.app
CLIENT_URL=https://your-app.vercel.app

# Neon PostgreSQL (required in production)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/tj_fms?sslmode=require
